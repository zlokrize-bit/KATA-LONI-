<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_overlay"
    android:padding="12dp"
    android:elevation="8dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="KATA LONI"
        android:textColor="@color/accent"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal" />

    <TextView
        android:id="@+id/textPingValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-- ms"
        android:textColor="@color/ping_good"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal" />

    <TextView
        android:id="@+id/textGameName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/gray"
        android:textSize="10sp"
        android:layout_gravity="center_horizontal" />

    <TextView
        android:id="@+id/textVpnStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚠️ غير محمي"
        android:textColor="@color/ping_bad"
        android:textSize="10sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp" />

</LinearLayout>
